# Copy to .env for local development. .env is gitignored; never commit real values.
#
# Vite inlines every VITE_* value into the client bundle AT BUILD TIME. Two
# consequences worth knowing before you add anything here:
#   1. Nothing in this file is secret. Treat each value as public.
#   2. Changing one in Vercel does nothing until a new build runs. An existing
#      deployment keeps the value it was built with.

# --- Supabase (required) -----------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# --- Analytics (optional; production only) -----------------------------------
# Both are deliberately left UNSET in local dev and preview builds. The
# components no-op without them, which is what keeps your own debugging out of
# the production reports.
#
# Clarity matters more than GA here: it records sessions and builds heatmaps, so
# a dev session is not just an extra hit, it is a recording that cannot be told
# apart from a real student's afterwards. Set it in Vercel Production only.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
